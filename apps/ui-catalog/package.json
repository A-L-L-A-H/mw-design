{
  "name": "@moonwitness/ui-catalog",
  "private": true,
  "version": "1.0.0-rc.1",
  "description": "Static, interactive catalog for the MoonWitness UI package",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "npm run build --workspace=@moonwitness/ui && npm run diagnostics:generate && tsc -p tsconfig.json && vite build",
    "build:built": "npm run diagnostics:generate && tsc -p tsconfig.json && vite build",
    "diagnostics:generate": "node scripts/generate-asset-diagnostics.mjs",
    "test": "playwright test",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 0.0.0.0 --port 3000"
  },
  "dependencies": {
    "@moonwitness/assets": "*",
    "@moonwitness/ui": "*",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.7.3",
    "vite": "^8.3.3"
  }
}
